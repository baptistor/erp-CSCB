{
  "$schema": "https://zardui.com/schema.json",
  "style": "nova",
  "icons": "lucide",
  "rtl": false,
  "projectType": "angular",
  "appConfigFile": "src/app/app.config.ts",
  "packageManager": "npm",
  "menuColor": "default",
  "menuAppearance": "solid",
  "menuAccent": "subtle",
  "preset": "Z4AAi",
  "tailwind": {
    "css": "src/styles.css",
    "baseColor": "mist"
  },
  "baseUrl": "src/app",
  "aliases": {
    "components": "@/shared/components",
    "utils": "@/shared/utils",
    "core": "@/shared/core",
    "services": "@/shared/services",
    "blocks": "@/shared/blocks"
  }
}